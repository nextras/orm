use:
	- nextras/coding-standard-plugin
	- nextras/preset

paths:
	- src
	- tests

fileExtensions:
	- php
	- phpt

# Preserve existing names and long lines while enforcing all other findings.
baseline: dresscode-baseline.neon

typeAnalysis: phpstan

nameResolution: certain
namespaces:
	functions:
		- NextrasBench\createModel
		- NextrasBench\generateArrayData
		- NextrasBench\generateRows
		- NextrasBench\jsonDecode
		- NextrasBench\seedDatabase
		- NextrasTests\Orm\Integration\BridgeNetteDI\buildDic
	constants:
		- NextrasBench\ITEM_PROPERTIES

overrides:
	-
		paths:
			- tests/cases/integration/Mapper/file.general.phpt
		# Keep model annotations for the repository property access exercised by this test.
		phpdoc:
			annotation:
				inlineVar: keep
	-
		paths:
			- tests/cases/unit/Entity/Reflection/MetadataParserExceptionsTest.phpt
		# Preserve the non-property annotation used by the metadata-parser test fixture.
		phpdoc:
			forbiddenAnnotations: keep
